DATABASE_URL=postgres://releve:releve@localhost:5432/releve
DEMO_MODE=true
DEMO_USE_REFERENCE_IMAGES=false
PAYMENT_PROVIDER=mock
SHIPPING_PROVIDER=mock
MESSAGING_PROVIDER=outbox
NEXT_PUBLIC_WA_NUMBER=6281200000000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
ADMIN_EMAIL=admin@releve.test
ADMIN_PASSWORD=releve-demo
AUTH_SECRET=change-me-to-a-long-random-string-32chars
WEBHOOK_SECRET=change-me-webhook-secret
CRON_SECRET=change-me-cron

# ---------------------------------------------------------------------------
# Go-live integrations (docs/11-go-live-integrations.md). Leave empty for the demo.
# Never commit real values — put them in .env.local / the hosting provider's secrets.
# ---------------------------------------------------------------------------

# Xendit (PAYMENT_PROVIDER=xendit) — Dashboard → Settings → API keys / Webhooks
# XENDIT_SECRET_KEY=xnd_development_...
# XENDIT_CALLBACK_TOKEN=            # "Webhook verification token", checked against header x-callback-token
# XENDIT_BASE_URL=https://api.xendit.co
# XENDIT_API_VERSION=2024-11-11     # Payments API v3 api-version header

# Biteship (SHIPPING_PROVIDER=biteship) — dashboard.biteship.com → Integrasi → API key
# BITESHIP_API_KEY=biteship_test....
# BITESHIP_ORIGIN_POSTAL_CODE=12160 # warehouse postal code (or BITESHIP_ORIGIN_AREA_ID)
# BITESHIP_ORIGIN_AREA_ID=
# BITESHIP_ORIGIN_LATITUDE=-6.2615  # warehouse pin, needed for instant couriers (gojek, grab)
# BITESHIP_ORIGIN_LONGITUDE=106.8106
# BITESHIP_COURIERS=jne,jnt,sicepat,anteraja,gojek,grab
# BITESHIP_USE_COURIER_INSURANCE=false  # true = Biteship insurance_fee instead of max(Rp2.500, 0,25%)
# BITESHIP_BASE_URL=https://api.biteship.com

# WhatsApp Business Cloud API (MESSAGING_PROVIDER=waba) — Meta App → WhatsApp → API setup
# WABA_TOKEN=                       # System User permanent token (whatsapp_business_messaging)
# WABA_PHONE_NUMBER_ID=
# WABA_API_VERSION=v26.0
# WABA_TEMPLATE_PREFIX=releve_      # releve_order_created, releve_payment_paid, …
# WABA_LANG_ID=id
# WABA_LANG_EN=en
