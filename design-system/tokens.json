{
  "$description": "Relevé Dance Supply — design tokens v1.0 (light mode only). Single source of truth; tokens.css is derived from this file. Contrast ratios checked against WCAG 2.1 AA (see docs/07-design-system.md §3).",
  "color": {
    "bg":            { "$value": "#FFFFFF", "$description": "Page background" },
    "surface":       { "$value": "#FFFFFF", "$description": "Card, drawer, modal" },
    "surface-alt":   { "$value": "#F7F4F0", "$description": "Alternating sections, summary panel, footer" },
    "ink":           { "$value": "#141414", "$description": "Primary text, primary button. 18.4:1 on bg" },
    "ink-muted":     { "$value": "#5E5852", "$description": "Secondary text, labels. 7.0:1 on bg, 6.4:1 on surface-alt" },
    "ink-subtle":    { "$value": "#8A837C", "$description": "Placeholder, non-essential text ≥18px. 3.7:1 — NOT for body text" },
    "ink-inverse":   { "$value": "#FFFFFF", "$description": "Text on ink" },
    "border":        { "$value": "#E6E1DB", "$description": "Decorative dividers, card outlines" },
    "border-strong": { "$value": "#8A837C", "$description": "Input & control borders (3.7:1, passes non-text 3:1)" },
    "focus":         { "$value": "#141414", "$description": "Focus ring 2px + offset 2px" },
    "accent":        { "$value": "#F3E1DD", "$description": "Ballet Pink — highlight backgrounds, New badge, hero tint. Not for text" },
    "accent-strong": { "$value": "#9A4A57", "$description": "Accent text/icons, link hover. 6.0:1 on bg" },
    "accent-ink":    { "$value": "#7E3845", "$description": "Text on accent. 6.55:1" },
    "success":       { "$value": "#1F7A4D" },
    "success-bg":    { "$value": "#E7F4EC" },
    "warning":       { "$value": "#8A5A00", "$description": "Pre-order, low stock (\"Sisa N\")" },
    "warning-bg":    { "$value": "#FBF1DC" },
    "error":         { "$value": "#B3261E" },
    "error-bg":      { "$value": "#FBE9E7" },
    "info":          { "$value": "#2A5DB0" },
    "info-bg":       { "$value": "#E8EFFA" },
    "whatsapp":      { "$value": "#25D366", "$description": "ONLY for WhatsApp buttons/icons" },
    "whatsapp-ink":  { "$value": "#0B2A17", "$description": "Text on whatsapp. 7.8:1 (white text is only 2:1 — forbidden)" },
    "overlay":       { "$value": "rgba(20,20,20,0.48)" }
  },
  "font": {
    "family": {
      "sans":    { "$value": "'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "$description": "UI, body, heading" },
      "display": { "$value": "'Cormorant Garamond', 'Times New Roman', serif", "$description": "Only for editorial hero taglines & quotes. Weight 500 italic/regular" },
      "mono":    { "$value": "ui-monospace, 'SFMono-Regular', Menlo, monospace", "$description": "VA numbers, order numbers, SKUs" }
    },
    "weight": { "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 } },
    "size": {
      "xs":  { "$value": "12px", "$description": "Caption, legal. line-height 16" },
      "sm":  { "$value": "14px", "$description": "Label, meta. lh 20" },
      "md":  { "$value": "16px", "$description": "Default body (minimum for inputs — prevents iOS zoom). lh 24" },
      "lg":  { "$value": "18px", "$description": "Lead, price on mobile PDP. lh 28" },
      "xl":  { "$value": "20px", "$description": "H4. lh 28" },
      "2xl": { "$value": "24px", "$description": "H3. lh 32" },
      "3xl": { "$value": "30px", "$description": "H2. lh 36" },
      "4xl": { "$value": "36px", "$description": "H1 mobile. lh 44" },
      "5xl": { "$value": "48px", "$description": "H1 desktop. lh 56" },
      "6xl": { "$value": "64px", "$description": "Hero display desktop. lh 68" }
    },
    "letter-spacing": {
      "tight":   { "$value": "-0.01em", "$description": "Heading ≥ 30px" },
      "normal":  { "$value": "0" },
      "eyebrow": { "$value": "0.12em", "$description": "UPPERCASE labels: nav, categories, badges" }
    }
  },
  "space": {
    "0": { "$value": "0px" }, "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" },
    "4": { "$value": "16px" }, "5": { "$value": "20px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" },
    "10": { "$value": "40px" }, "12": { "$value": "48px" }, "16": { "$value": "64px" }, "20": { "$value": "80px" }, "24": { "$value": "96px" }
  },
  "radius": {
    "none": { "$value": "0px",   "$description": "Product images, banners" },
    "sm":   { "$value": "2px",   "$description": "Buttons, inputs, badges — crisp & precise" },
    "md":   { "$value": "4px",   "$description": "Cards, payment-method tiles" },
    "lg":   { "$value": "8px",   "$description": "Modals, drawers (top corners on mobile sheets)" },
    "pill": { "$value": "999px", "$description": "Color swatches, filter chips, floating WA button" }
  },
  "shadow": {
    "none":    { "$value": "none" },
    "overlay": { "$value": "0 8px 32px rgba(20,20,20,0.16)", "$description": "Only drawers/modals/popovers. Cards do NOT use shadows" }
  },
  "border-width": { "hairline": { "$value": "1px" }, "strong": { "$value": "2px", "$description": "Selected state (size, swatch, payment tile)" } },
  "motion": {
    "duration": { "fast": { "$value": "120ms" }, "base": { "$value": "200ms" }, "slow": { "$value": "320ms" } },
    "easing": { "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" } },
    "$description": "Respect prefers-reduced-motion: all durations → 0"
  },
  "layout": {
    "breakpoint": { "sm": { "$value": "360px" }, "md": { "$value": "768px" }, "lg": { "$value": "1024px" }, "xl": { "$value": "1280px" } },
    "container-max": { "$value": "1280px" },
    "gutter": { "mobile": { "$value": "16px" }, "tablet": { "$value": "24px" }, "desktop": { "$value": "32px" } },
    "grid-columns": { "mobile": { "$value": 4 }, "tablet": { "$value": 8 }, "desktop": { "$value": 12 } },
    "header-height": { "mobile": { "$value": "56px" }, "desktop": { "$value": "72px" } },
    "touch-target-min": { "$value": "44px" }
  },
  "z": { "header": { "$value": 40 }, "drawer": { "$value": 50 }, "modal": { "$value": 60 }, "toast": { "$value": 70 }, "wa-fab": { "$value": 30 } }
}
